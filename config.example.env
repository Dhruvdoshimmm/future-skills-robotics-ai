# Copy these values into the environment of your PHP hosting provider.
DB_HOST=127.0.0.1
DB_NAME=future_skills
DB_USER=future_skills_user
DB_PASS=CHANGE_ME

# Exact administrator login email.
ADMIN_EMAIL=admin@example.com

# Generate with:
# php -r "echo password_hash('CHANGE_ME', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=$2y$10$REPLACE_WITH_A_REAL_PASSWORD_HASH

# Long random secret, at least 32 bytes.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Comma-separated exact browser origins.
# Example:
# ALLOWED_ORIGINS=https://your-project.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=https://future-skills-robotics-ai.vercel.app
